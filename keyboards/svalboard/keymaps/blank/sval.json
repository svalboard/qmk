                        {
                            "label": "Natural Scroll",
                            "type": "toggle",
                            "content": ["id_natural_scroll", 1, 7]
                        },
                        {
                            "label": "Axis Lock",
                            "type": "toggle",
                            "content": ["id_axis_lock", 1, 8]
                        }
                    ]
                },
                {
                    "label": "Advanced",
                    "content": [
                        {
                            "label": "Scan Pre-wait (us)",
                            "type": "range",
                            "options": [1, 1000],
                            "content": ["id_scan_prewait_us", 1, 13]
                        },
                        {
                            "label": "Scan Post-wait (us)",
                            "type": "range",
                            "options": [1, 1000],
                            "content": ["id_scan_postwait_us", 1, 14]
                        },
                        {
                            "label": "Scan Period (us, 0 = unpaced)",
                            "type": "range",
                            "options": [0, 20000],
                            "content": ["id_scan_period_us", 1, 20]
                        },
                        {
                            "label": "Light Idle Period (ms)",
                            "type": "range",
                            "options": [0, 60000],
                            "content": ["id_scan_idle_period_ms", 1, 21]
                        },
                        {
                            "label": "Light Idle After (ms, 0 = never)",

                            "options": [0, 60000],
                            "content": ["id_scan_idle_after_ms", 1, 22]
                        },
                        {
                            "label": "Deep Idle After (s, 0 = never)",
                            "type": "range",
                            "options": [0, 7200],
                            "content": ["id_scan_deep_after_s", 1, 23]
                        },
                        {
                            "label": "Deep Idle Period (ms)",
                            "type": "range",
                            "options": [0, 60000],
                            "content": ["id_scan_deep_period_ms", 1, 24]
                        },
                        {
                            "label": "Trackball Rest Mode",
                            "type": "toggle",
                            "content": ["id_idle_pointer_rest", 1, 25]
                        },
                        {
                            "label": "Dim RGB When Idle",
                            "type": "toggle",
                            "content": ["id_idle_rgb_dim", 1, 26]
                        },
                        {
                            "label": "Sleep Between Scans",
                            "type": "toggle",
                            "content": ["id_idle_cpu_sleep", 1, 27]
                        },
                        {
                            "label": "Low Clock In Deep Idle",
                            "type": "toggle",
                            "content": ["id_idle_low_clock", 1, 28]
                        },
                        {
                            "label": "Long Naps In Deep Idle",
                            "type": "toggle",
                            "content": ["id_idle_long_nap", 1, 29]
                        },
                        {
                            "label": "Deep Idle Clock",
                            "type": "dropdown",
                            "options": ["48 MHz", "24 MHz", "12 MHz"],
                            "content": ["id_scan_deep_clock_idx", 1, 30]
                        }
                    ]
                }
            ]
        }
